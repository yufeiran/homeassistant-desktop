{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Home Assistant Desktop",
  "version": "1.8.2",
  "identifier": "com.iprodanovbg.homeassistant-desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Home Assistant in the operating system webview",
    "longDescription": "A small tray application for Home Assistant using WebView2 on Windows, WKWebView on macOS, and WebKitGTK on Linux.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
